# ------------------ CORS CONFIGURATION ------------------
# Configuración para habilitar solicitudes CORS desde el cliente
client.url=http://localhost:4200

# ------------------ SERVER CONFIGURATION ------------------
# Cambiar el puerto predeterminado del servidor
# server.port=9000

# Evitar que la aplicación se detenga si la base de datos está caída
spring.sql.init.continue-on-error=true

# ------------------ DATABASE CONFIGURATION ------------------
# Configuración de Hibernate para la base de datos MySQL
spring.jpa.hibernate.ddl-auto=update
spring.datasource.url=jdbc:mysql://localhost:3306/db_fichajespi
spring.datasource.username=fichajes
spring.datasource.password=fichajes
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Mostrar sentencias SQL en la consola
spring.jpa.show-sql=false

# Configuración para que Hibernate utilice el dialecto de MySQL
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL5Dialect

# ------------------ EMAIL CONFIGURATION ------------------
# Configuración para enviar correos electrónicos
spring.mail.host=smtp.mailtrap.io
spring.mail.port=2525
spring.mail.username=xxx  # Cambiar a tu usuario real
spring.mail.password=xxx  # Cambiar a tu contraseña real

# Otras configuraciones de correo
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
# Configuración alternativa para SSL (comentada)
# spring.mail.properties.mail.smtp.socketFactory.port=465
# spring.mail.properties.mail.smtp.socketFactory.class=javax.net.ssl.SSLSocketFactory

# ------------------ SECURITY CONFIGURATION ------------------
# Configuración de JWT
jwt.secret=very-secure-secret
jwt.expiration=36000000  # Tiempo de expiración en milisegundos (ej. 10 horas)

# ------------------ ADMIN CONFIGURATION ------------------
# Configuración de usuario administrador (comentada)
# admin.numero=fichajesPi_12345
# admin.pass=fichajesPi_12345
